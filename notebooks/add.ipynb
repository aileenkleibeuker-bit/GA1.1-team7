   "source": [
    "def add(a,b):\n",
    "    return a + b\n",
    "\n",
    "print(add(2,3))\n",
    "\n",
    "print(add(4,5))\n",
    "\n",
    "print(add(6, 1))\n",
    "\n",
    "def sum_list(values):\n",
    "    total = 0\n",
    "    for i in values:\n",
    "        total += i\n",
    "    return total\n",
    "\n",
    "print(sum_list([add(2,3), add(4,5), add(6,1)]))"
   ]
